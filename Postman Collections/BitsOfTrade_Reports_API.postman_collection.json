{
  "info": {
    "name": "BitsOfTrade — Reports API",
    "description": "Complete test suite for all 7 report endpoints.\n\n**Setup**\n1. Set the `base_url` variable to your server, e.g. `http://localhost:8000`.\n2. Set `access_token` to a valid JWT (run the Auth / Login request first — it sets the token automatically).\n3. Set `strategy_uuid` to a real strategy UUID from your database.\n\nAll filter parameters are pre-filled as examples. Toggle them on/off in the Params tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token",  "value": "",                      "type": "string" },
    { "key": "strategy_uuid", "value": "replace-with-real-uuid","type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (get JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "    pm.test('Token saved', () => pm.expect(json.access).to.be.a('string'));",
                  "} else {",
                  "    pm.test('Login failed — check credentials', () => pm.expect(json.access).to.exist);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            }
          }
        }
      ]
    },

    {
      "name": "📊 Performance",
      "item": [

        {
          "name": "Performance — No filters (all time)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "var json = pm.response.json();",
            "if (json.message) {",
            "    pm.test('Empty range message present', () => pm.expect(json.message).to.be.a('string'));",
            "} else {",
            "    pm.test('Has performance object', () => pm.expect(json).to.have.property('performance'));",
            "    pm.test('Has net_pnl_cumulative array', () => pm.expect(json.net_pnl_cumulative).to.be.an('array'));",
            "    pm.test('Has net_daily_pnl array', () => pm.expect(json.net_daily_pnl).to.be.an('array'));",
            "    pm.test('Has performance_breakdown', () => pm.expect(json).to.have.property('performance_breakdown'));",
            "    pm.test('Has time_metrics', () => pm.expect(json).to.have.property('time_metrics'));",
            "    pm.test('Has duration_insights', () => pm.expect(json).to.have.property('duration_insights'));",
            "    pm.test('Has hold_time_vs_win_rate array', () => pm.expect(json.hold_time_vs_win_rate).to.be.an('array'));",
            "    pm.test('Has market_session_breakdown array', () => pm.expect(json.market_session_breakdown).to.be.an('array'));",
            "    pm.test('Has strategy_effectiveness array', () => pm.expect(json.strategy_effectiveness).to.be.an('array'));",
            "    pm.test('Has symbol_frequency object', () => pm.expect(json).to.have.property('symbol_frequency'));",
            "    pm.test('Has capital_usage object', () => pm.expect(json).to.have.property('capital_usage'));",
            "    pm.test('Has quantity_analysis object', () => pm.expect(json).to.have.property('quantity_analysis'));",
            "    pm.test('Win rate is a number', () => pm.expect(json.performance.win_rate).to.be.a('number'));",
            "    pm.test('Total trades >= 0', () => pm.expect(json.performance.total_trades).to.be.at.least(0));",
            "}"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/reports/performance/", "host": ["{{base_url}}"], "path": ["api","reports","performance",""] }
          }
        },

