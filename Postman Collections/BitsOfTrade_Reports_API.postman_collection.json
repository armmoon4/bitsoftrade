            "pm.test('VMI has direction field', () => pm.expect(json.kpis.VMI).to.have.property('direction'));",
            "pm.test('Has violations_timeline array', () => pm.expect(json.violations_timeline).to.be.an('array'));",
            "pm.test('Has mistake_heatmap array', () => pm.expect(json.mistake_heatmap).to.be.an('array'));",
