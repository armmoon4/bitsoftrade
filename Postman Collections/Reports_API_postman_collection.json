{
    "info": {
        "name": "Reports API",
        "description": "API endpoints for the Reports module providing on-demand analytical reports derived from trade data.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Performance Report",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/reports/performance/?from=2025-01-01&to=2025-01-31&market=all&broker=all",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "reports", "performance", ""],
                    "query": [
                        { "key": "from",   "value": "2025-01-01" },
                        { "key": "to",     "value": "2025-01-31" },
                        { "key": "market", "value": "all" },
                        { "key": "broker", "value": "all" }
                    ]
                }
