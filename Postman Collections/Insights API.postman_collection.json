{
    "info": {
        "name": "Insights API",
        "description": "API endpoints for the Insights module exposing BitsOfTrade's 12 proprietary behavioral and discipline metrics.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Get Metrics Snapshot",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/insights/metrics/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "insights",
                        "metrics",
                        ""
                    ]
                }
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:13025"
        },
        {
            "key": "access_token",
            "value": ""
        }
    ]
}