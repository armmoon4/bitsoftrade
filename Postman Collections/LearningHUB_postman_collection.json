            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python Fundamentals\",\n  \"about\": \"A beginner-friendly Python course.\",\n  \"description\": \"Covers variables, loops, functions, and more.\",\n  \"lessons\": {{lessonId}},\n  \"course_type\": \"general\",\n  \"course_level\": \"beginner\",\n  \"is_active\": true\n}",
              "options": {
