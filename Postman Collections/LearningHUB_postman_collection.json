          "name": "POST Start Course Progress Tracking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains message and course_progress\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('course_progress');",
                  "    pm.expect(jsonData.course_progress).to.have.property('user');",
                  "    pm.expect(jsonData.course_progress).to.have.property('course');",
                  "});"
                ],
                "type": "text/javascript"
              }
