{
    "info": {
        "name": "Strategies API",
        "description": "API endpoints for the Strategies module managing user, template, and community strategies.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "List My Strategies",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ""
                    ]
                }
            }
        },
        {
            "name": "Create Strategy",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"strategy_name\": \"Opening Range Breakout\",\n  \"description\": \"Trade breakouts from the first 15-min range.\",\n  \"tags\": [\"breakout\", \"morning\"],\n  \"market_types\": [\"Indian Stocks\", \"Options\"],\n  \"trade_type\": \"intraday\",\n  \"is_public\": false,\n  \"sample_size_threshold\": 30\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ""
                    ]
                },
                "description": "Creates a new strategy. Note: 'trade_type' choices are 'intraday', 'swing', or 'positional'."
            }
        },
        {
            "name": "Community Strategies",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/community/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        "community",
                        ""
                    ]
                }
            }
        },
        {
            "name": "Template Strategies",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/templates/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        "templates",
                        ""
                    ]
                }
            }
        },
        {
            "name": "Get Strategy",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/:id/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ":id",
                        ""
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "00000000-0000-0000-0000-000000000000",
                            "description": "Must be a valid UUID"
                        }
                    ]
                }
            }
        },
        {
            "name": "Update Strategy",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"strategy_name\": \"Updated Strategy Name\",\n  \"trade_type\": \"swing\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/:id/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ":id",
                        ""
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "00000000-0000-0000-0000-000000000000",
                            "description": "Must be a valid UUID"
                        }
                    ]
                }
            }
        },
        {
            "name": "Delete Strategy",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "DELETE",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/:id/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ":id",
                        ""
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "00000000-0000-0000-0000-000000000000",
                            "description": "Must be a valid UUID"
                        }
                    ]
                }
            }
        },
        {
            "name": "Add to Mine (Clone Community Strategy)",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/:id/add-to-mine/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ":id",
                        "add-to-mine",
                        ""
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "00000000-0000-0000-0000-000000000000",
                            "description": "Must be a valid UUID of a public community strategy"
                        }
                    ]
                }
            }
        },
        {
            "name": "Assign Trades to Strategy",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{access_token}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"assign_all_untagged\": true\n}\n\n// Alternative payloads (only send ONE of the below configurations in standard JSON formatting):\n// {\n//   \"trade_ids\": [\"11111111-1111-1111-1111-111111111111\", \"22222222-2222-2222-2222-222222222222\"]\n// }\n// OR\n// {\n//   \"assign_all\": true\n// }"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/strategies/:id/assign-trades/",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "strategies",
                        ":id",
                        "assign-trades",
                        ""
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "00000000-0000-0000-0000-000000000000",
                            "description": "Must be a valid UUID"
                        }
                    ]
                },
                "description": "Assigns trades to this strategy. Body options (mutually exclusive): `trade_ids` (list of UUIDs), `assign_all_untagged` (boolean), or `assign_all` (boolean)."
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:13025"
        },
        {
            "key": "access_token",
            "value": "your_jwt_token_here"
        }
    ]
}