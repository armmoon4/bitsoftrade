            "name": "Daily Journals",
            "item": [
                {
                    "name": "List Daily Journals",
                    "request": {
                        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ] },
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/journal/daily/",
