                            "raw": "{\n  \"journal_date\": \"2025-01-15\",\n  \"session_state\": \"green\",\n  \"prompt_text\": \"What went well today?\",\n  \"reflection\": \"Stayed disciplined.\",\n  \"intention_next_session\": \"Be patient.\",\n  \"limits_followed\": \"yes\"\n}"
