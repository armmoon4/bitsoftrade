{
  "info": {
    "name": "Account API",
    "description": "API endpoints for the Account module handling user authentication, registration, profile management, onboarding, and subscription-based access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"password_confirm\": \"password123\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register", ""]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login", ""]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "logout", ""]
        }
      }
    },
    {
      "name": "Get Current User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", ""]
        }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/profile/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "profile", ""]
        }
      }
    },
    {
      "name": "Update Profile (Full)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Updated\",\n  \"last_name\": \"Name\",\n  \"email\": \"updated@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/profile/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "profile", ""]
        }
      }
    },
    {
      "name": "Update Profile (Partial)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"PartialUpdate\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/profile/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "profile", ""]
        }
      }
    },
    {
      "name": "Complete Onboarding",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/onboarding/complete/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "onboarding", "complete", ""]
        },
        "description": "Marks onboarding as completed for the authenticated user. Call this when the user finishes the onboarding flow. After this, user.onboarding_completed will be true on all future logins."
      }
    },
    {
      "name": "Change Password",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"old_password\": \"password123\",\n  \"new_password\": \"newpassword456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/password/change/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "password", "change", ""]
        }
      }
    },
    {
      "name": "Request Password Reset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/password/reset/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "password", "reset", ""]
        }
      }
    },
    {
      "name": "Confirm Password Reset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"uidb64\": \"<uidb64_from_reset_link>\",\n  \"token\": \"<token_from_reset_link>\",\n  \"new_password\": \"newpassword456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/password/reset/confirm/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "password", "reset", "confirm", ""]
        }
      }
    },
    {
      "name": "Google Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<google_oauth2_id_token>\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/google-login/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "google-login", ""]
        }
      }
    },
    {
      "name": "Token - Obtain Pair",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "token", ""]
        }
      }
    },
    {
      "name": "Token - Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/token/refresh/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "token", "refresh", ""]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:13025"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ]
}
