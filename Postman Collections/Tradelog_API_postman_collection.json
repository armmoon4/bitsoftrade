                    "raw": "{\n  \"trade_date\": \"2025-01-15\",\n  \"trade_time\": \"10:30:00\",\n  \"symbol\": \"RELIANCE\",\n  \"market_type\": \"indian_market\",\n  \"direction\": \"long\",\n  \"quantity\": \"10\",\n  \"entry_price\": \"2450.00\",\n  \"exit_price\": \"2510.00\",\n  \"fees\": \"25.00\",\n  \"stop_loss\": \"2400.00\",\n  \"target\": \"2550.00\",\n  \"leverage\": \"1\",\n  \"strategy\": null,\n  \"entry_confidence\": 7,\n  \"satisfaction_rating\": 8,\n  \"emotional_state\": \"calm\",\n  \"violation_modes\": [],\n  \"lessons_learned\": \"Waited for confirmation before entry.\",\n  \"rules_followed\": [\"Respected stop loss\"],\n  \"screenshot_urls\": [],\n  \"broker_name\": \"Zerodha\",\n  \"import_source\": \"manual\"\n}"
                },
