{
    "info": {
        "name": "Tradelog API",
        "description": "API endpoints for the Tradelog module managing trade creation, retrieval, update, soft-delete, and bulk CSV/Excel import.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "List Trades",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [ { "key": "token", "value": "{{access_token}}", "type": "string" } ]
                },
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/api/tradelog/trades/?page=1&page_size=5",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "tradelog", "trades", ""],
                    "query": [
                        { "key": "page",      "value": "1" },
                        { "key": "page_size", "value": "5" },
                        { "key": "filter",          "value": "",    "disabled": true, "description": "wins | losses | disciplined | violations" },
                        { "key": "broker",          "value": "",    "disabled": true, "description": "e.g. zerodha | upstox | groww (case-insensitive)" },
                        { "key": "market_type",     "value": "",    "disabled": true, "description": "indian_market | forex | crypto | options" },
                        { "key": "date_range",      "value": "",    "disabled": true, "description": "today | this_week | this_month | custom" },
                        { "key": "date_from",       "value": "",    "disabled": true, "description": "YYYY-MM-DD — used when date_range=custom" },
                        { "key": "date_to",         "value": "",    "disabled": true, "description": "YYYY-MM-DD — used when date_range=custom" },
                        { "key": "direction",       "value": "",    "disabled": true, "description": "long | short" },
                        { "key": "outcome",         "value": "",    "disabled": true, "description": "win | loss | open" },
                        { "key": "instrument_type", "value": "",    "disabled": true, "description": "indian_market | forex | crypto | options (alias for market_type)" },
                        { "key": "strategy",        "value": "",    "disabled": true, "description": "Strategy UUID" },
                        { "key": "emotional_state", "value": "",    "disabled": true, "description": "calm | anxious | confident | fearful | fomo | angry | overconfident | uncertain" },
                        { "key": "discipline_status","value": "",   "disabled": true, "description": "disciplined | violations" },
                        { "key": "review_status",   "value": "",    "disabled": true, "description": "tagged | untagged" },
                        { "key": "rule_breach",     "value": "",    "disabled": true, "description": "comma-separated e.g. fomo_entry,overtrading" },
                        { "key": "pnl_min",         "value": "",    "disabled": true, "description": "P&L lower bound e.g. -10000" },
                        { "key": "pnl_max",         "value": "",    "disabled": true, "description": "P&L upper bound e.g. 10000" },
                        { "key": "mistakes",        "value": "",    "disabled": true, "description": "comma-separated: fomo_entry | revenge_trading | oversized_position | premature_exit | ignored_stop_loss | overtrading" },
                        { "key": "tags",            "value": "",    "disabled": true, "description": "comma-separated tag strings — searches violation_modes and rules_followed" },
                        { "key": "search",          "value": "",    "disabled": true, "description": "free-text search on symbol, broker_name, lessons_learned" }
                    ]
                }
            }
        },
